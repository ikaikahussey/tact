{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Project",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Tact": {
      "deploymentTarget": "26.0",
      "info": {
        "path": "App\/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Tact",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "NSContactsUsageDescription": "This app needs access to your contacts to link people to your address book.",
          "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select images for the Art game tiles.",
          "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to convert speech to text.",
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.316995a7-05d8-43bf-a05c-61576ad62094",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    }
  }
}
