{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Tact",
  "options": {
    "bundleIdPrefix": "com.ikaikahussey",
    "deploymentTarget": {
      "iOS": "17.0"
    },
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "SWIFT_VERSION": "5.0"
  },
  "targets": {
    "Tact": {
      "deploymentTarget": "17.0",
      "info": {
        "path": "App/Info.plist"
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.ikaikahussey.tact",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    },
    "TactTests": {
      "dependencies": [
        {
          "target": "Tact"
        }
      ],
      "platform": "iOS",
      "settings": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.ikaikahussey.tact.tests"
      },
      "sources": [
        {
          "path": "Tests/TactTests"
        }
      ],
      "type": "bundle.unit-test"
    }
  }
}
